{
  "name": "@typed-web/form-react",
  "version": "0.1.0",
  "description": "React hooks and components for @typed-web/form-store",
  "author": "Łukasz Jagodziński <luke.jagodzinski@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typed-web/typed-web.git",
    "directory": "packages/form-react"
  },
  "homepage": "https://github.com/typed-web/typed-web/tree/main/packages/form-react#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@typed-web/form-store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@types/react": "^19.0.6",
    "esbuild": "^0.27.2",
    "react": "^19.0.0"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:esm",
    "build:esm": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=neutral --sourcemap --external:react --external:@typed-web/form-store",
    "build:types": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "test": "node --disable-warning=ExperimentalWarning --test './src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "form",
    "react",
    "hooks",
    "components",
    "typescript"
  ]
}
