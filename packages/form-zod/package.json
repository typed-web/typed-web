{
  "name": "@typed-web/form-zod",
  "version": "0.1.0",
  "description": "Zod error adapters for form handling",
  "author": "Łukasz Jagodziński <luke.jagodzinski@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typed-web/typed-web.git",
    "directory": "packages/form-zod"
  },
  "homepage": "https://github.com/typed-web/typed-web/tree/main/packages/form-zod#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@typed-web/form-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "esbuild": "^0.27.2",
    "zod": "^4.3.6"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:esm",
    "build:esm": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=neutral --sourcemap --external:zod --external:@typed-web/form-utils",
    "build:types": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "test": "node --disable-warning=ExperimentalWarning --test './src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zod",
    "form",
    "validation",
    "errors",
    "typescript"
  ]
}
